# =============================================================================
# TheChess — Environment Configuration Template
# Sao chép tệp này sang .env và điều chỉnh theo nhu cầu triển khai.
# =============================================================================

# Môi trường chạy: development | production
THECHESS_ENV=development

# Khóa bí mật ký session token (chuỗi ngẫu nhiên tối thiểu 32 byte)
# Tạo nhanh: python3 -c "import secrets; print(secrets.token_hex(32))"
THECHESS_SECRET_KEY=replace-with-a-secure-random-token-in-production

# Đường dẫn tệp khóa bí mật (dùng khi THECHESS_SECRET_KEY để trống)
THECHESS_SECRET_KEY_FILE=backend/data/.secret_key

# Đường dẫn cơ sở dữ liệu SQLite
THECHESS_DB_PATH=backend/data/thechess.db

# Tài khoản quản trị mặc định (khởi tạo trong lần chạy đầu tiên)
THECHESS_ADMIN_USER=admin
# Bỏ trống để hệ thống tự sinh mật khẩu ngẫu nhiên và in ra log
THECHESS_ADMIN_PASSWORD=

# Danh sách Origin được phép truy cập CORS (phân tách bởi dấu phẩy)
THECHESS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# Địa chỉ IP LAN tùy chọn để hiển thị trong liên kết mời/QR code
THECHESS_LAN_IP=

# --- Cấu hình Engine Pool ---
# Kích thước hồ tiến trình Stockfish chạy nền
THECHESS_ENGINE_POOL=3

# Số tiến trình Lc0 tối đa cho mỗi mức Elo (Maia)
THECHESS_MAX_LC0_PER_ELO=2

# Tổng số tiến trình Lc0 tối đa trên toàn hệ thống
THECHESS_MAX_TOTAL_LC0=6

# Thời gian chờ (giây) trước khi giải phóng tiến trình Lc0 không hoạt động
THECHESS_LC0_IDLE_TIMEOUT=900
