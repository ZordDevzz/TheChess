# =============================================================================
# TheChess - Environment Configuration
# Copy this file to .env and adjust values as needed.
# =============================================================================

# Environment mode: development | production
THECHESS_ENV=development

# Secret key for session authentication tokens (min 32 bytes)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
THECHESS_SECRET_KEY=

# Path to persistent secret key file (used when THECHESS_SECRET_KEY is empty)
THECHESS_SECRET_KEY_FILE=backend/data/.secret_key

# SQLite database file path
THECHESS_DB_PATH=backend/data/thechess.db

# Initial admin account bootstrap
THECHESS_ADMIN_USER=admin
# Leave empty to generate a random password on first run (printed to log)
THECHESS_ADMIN_PASSWORD=

# Allowed CORS origins (comma-separated)
THECHESS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# Optional LAN IP for local match invite links / QR codes
THECHESS_LAN_IP=

# --- Engine Pool Configuration ---
# Maximum concurrent Stockfish worker instances
THECHESS_ENGINE_POOL=3

# Maximum concurrent Lc0 workers per Elo rating
THECHESS_MAX_LC0_PER_ELO=2

# Maximum concurrent Lc0 workers across all ratings
THECHESS_MAX_TOTAL_LC0=6

# Idle timeout in seconds before releasing idle Lc0 instances
THECHESS_LC0_IDLE_TIMEOUT=900
